# GuardianMail AI — Frontend Environment Variables

# Backend API base URL (required)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Demo mode — when true, shows a visible "DEMO MODE" banner and may use sample data
# Production must be VITE_DEMO_MODE=false
VITE_DEMO_MODE=false

# Google Identity Services (GIS) Web Client ID
# Set this to your Google Cloud Console OAuth 2.0 Web Client ID.
# If omitted, the frontend will automatically fetch it from /api/v1/auth/google/config.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
