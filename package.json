{
  "name": "guardianmail-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "GuardianMail AI - Enterprise Email Threat Analysis & Security Workspace",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "start:backend": "cd backend && python -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview",
    "test:frontend": "npm --prefix frontend run test:unit",
    "test:backend": "cd backend && python -m pytest tests/test_google_auth.py tests/test_identity_verification.py -v"
  }
}
