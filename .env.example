# ==============================================================================
# GUARDIANMAIL AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core Application settings
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=generate-a-long-random-hex-string-for-security-jwt-signing

# Database Connectivity Configuration (MongoDB Atlas)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=guardianmail
MONGODB_POOL_SIZE=100
MONGODB_TIMEOUT_MS=5000

# Cache and Asynchronous Queue Configuration (Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Cors allowed origins whitelist
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,https://guardianmail.ai

# Google OAuth 2.0 Identity Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Threat intelligence API Integration Keys
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here
SAFE_BROWSING_API_KEY=your-google-safe-browsing-api-key-here
