# ==============================================================================
# GUARDIANMAIL AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core Application settings
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=generate-a-long-random-hex-string-for-security-jwt-signing

# Database Connectivity Configuration (MongoDB Atlas)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=guardianmail
MONGODB_POOL_SIZE=100
MONGODB_TIMEOUT_MS=5000

# Cache and Asynchronous Queue Configuration (Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Cors allowed origins whitelist
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,https://guardianmail.ai

# Google OAuth 2.0 & Identity Services Configuration
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Redirect URI used for server-side code exchange (if using code flow)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# NOTE: User authentication uses OpenID Connect (openid, email, profile).
# Gmail API access (https://www.googleapis.com/auth/gmail.readonly) is requested separately after sign-in.

# Application Base URLs
APP_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Multi-Channel Identity Verification Challenges
AUTH_CODE_TTL_SECONDS=600
AUTH_RESEND_COOLDOWN_SECONDS=60
AUTH_MAX_VERIFICATION_ATTEMPTS=5

# Transactional Email Provider (options: console, smtp, resend, sendgrid)
# In development/testing, use 'console' for safe terminal verification output.
EMAIL_PROVIDER=console
EMAIL_API_KEY=your-email-provider-api-key
EMAIL_FROM_ADDRESS=security@guardianmail.ai

# SMTP Configuration (required only if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=postmaster@guardianmail.ai
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=True

# SMS Verification Provider (options: console, twilio, twilio_verify)
# In development/testing, use 'console' for safe terminal verification output.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid
TWILIO_FROM_NUMBER=+18005550199

# Threat intelligence API Integration Keys
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here
SAFE_BROWSING_API_KEY=your-google-safe-browsing-api-key-here
